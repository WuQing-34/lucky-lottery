# ============================================================
#  幸运大转盘 —— 版本库忽略规则
#  原则：**运行时数据绝不入库**（里面有管理密码哈希、用户名单、抽奖记录）
# ============================================================

# ---- 运行时数据：数据库 / 配置 / 用户名单 / 抽奖记录 ----
data/
*.db
*.db-wal
*.db-shm
*.db.bak-*
*.db.bak
config.json
config.json.tmp

# ---- 部署产物 / 备份包 ----
*.tar.gz
*.tgz
*.zip

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 截图（README 里引用的实拍图；界面已改版，重拍后再入库）----
screenshots/

# ---- 日志 / 临时文件 ----
*.log
*.tmp
